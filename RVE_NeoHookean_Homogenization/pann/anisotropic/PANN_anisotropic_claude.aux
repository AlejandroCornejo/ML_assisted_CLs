\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Test-trajectory comparison, direct FOM vs.\ all six model variants of Table~\ref {tab:master} (the tier-1 pure-regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes): the three second Piola--Kirchhoff components $S_{11}$, $S_{22}$, $S_{12}$ and the von Mises equivalent $\sigma _{\rm  eq}$, each shown for all six variants, plus energy $W$, shown only for the three energy-capable tiers (tier 2, tier 3a, tier 3b): the tier-1 pure-regression model and both HPROM--ANN modes recover stress directly, without an underlying scalar potential, so no energy curve exists for them to plot (Section~\ref {sec:c1-regression} for tier 1; Section~\ref {sec:results}'s discussion of the reaction-force procedure for the two HPROM--ANN modes). Every plotted variant is visually indistinguishable from the FOM and from each other on this test path (including the free model, whose lack of a polyconvexity certificate is not visible here), which is exactly why Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex} audit them directly (cyclic work, rank-one curvature) rather than relying on this figure.}}{28}{figure.15}\protected@file@percent }
\newlabel{fig:full-comparison}{{15}{28}{Test-trajectory comparison, direct FOM vs.\ all six model variants of Table~\ref {tab:master} (the tier-1 pure-regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes): the three second Piola--Kirchhoff components $S_{11}$, $S_{22}$, $S_{12}$ and the von Mises equivalent $\sigma _{\rm eq}$, each shown for all six variants, plus energy $W$, shown only for the three energy-capable tiers (tier 2, tier 3a, tier 3b): the tier-1 pure-regression model and both HPROM--ANN modes recover stress directly, without an underlying scalar potential, so no energy curve exists for them to plot (Section~\ref {sec:c1-regression} for tier 1; Section~\ref {sec:results}'s discussion of the reaction-force procedure for the two HPROM--ANN modes). Every plotted variant is visually indistinguishable from the FOM and from each other on this test path (including the free model, whose lack of a polyconvexity certificate is not visible here), which is exactly why Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex} audit them directly (cyclic work, rank-one curvature) rather than relying on this figure}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Test-trajectory relative $L^2$ error, all six reported quantities of Table~\ref {tab:master}, for all six model variants: the tier-1 pure-regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes. The uncertified ANNs (tiers 1--2) are competitive with, and on several components better than, the certified models on every accuracy metric shown here: consistent with Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex}'s point that accuracy alone cannot distinguish a certified model from an uncertified one; only the cyclic-work and rank-one curvature audits can.}}{28}{figure.16}\protected@file@percent }
