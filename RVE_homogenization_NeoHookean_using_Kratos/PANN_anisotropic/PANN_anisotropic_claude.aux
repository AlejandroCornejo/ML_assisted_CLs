\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Held-out Stage--10 trajectories: energy, the three second Piola components, and the von Mises equivalent, direct FOM vs.\ the polyconvex PANN (every PANN stress shown here is differentiated from the displayed PANN energy); and the same relative-$L^2$-error comparison against the direct HPROM--ANN reconstruction on the same path. The direct HPROM--ANN reconstruction is a dedicated high-fidelity reduced-order reconstruction and is more accurate on $W$, $S_{11}$, $S_{22}$ in absolute terms; the polyconvex PANN is, notably, more accurate on $S_{12}$, consistent with the loss re-weighting of Section~\ref {sec:loss}.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:stage10}{{2}{15}{Held-out Stage--10 trajectories: energy, the three second Piola components, and the von Mises equivalent, direct FOM vs.\ the polyconvex PANN (every PANN stress shown here is differentiated from the displayed PANN energy); and the same relative-$L^2$-error comparison against the direct HPROM--ANN reconstruction on the same path. The direct HPROM--ANN reconstruction is a dedicated high-fidelity reduced-order reconstruction and is more accurate on $W$, $S_{11}$, $S_{22}$ in absolute terms; the polyconvex PANN is, notably, more accurate on $S_{12}$, consistent with the loss re-weighting of Section~\ref {sec:loss}}{figure.2}{}}
