\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Held-out Stage--10 von Mises trajectory: direct FOM vs.\ all six model variants of Table~\ref {tab:master} (the tier-1 regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes). Every variant is visually indistinguishable from the FOM and from each other on this held-out path -- including the tier-1 regression model, which has no energy potential at all, and the free model, whose lack of a polyconvexity certificate is not visible here -- which is exactly why Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex} audit them directly (cyclic work, rank-one curvature) rather than relying on this figure.}}{16}{figure.3}\protected@file@percent }
\newlabel{fig:full-comparison}{{3}{16}{Held-out Stage--10 von Mises trajectory: direct FOM vs.\ all six model variants of Table~\ref {tab:master} (the tier-1 regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes). Every variant is visually indistinguishable from the FOM and from each other on this held-out path -- including the tier-1 regression model, which has no energy potential at all, and the free model, whose lack of a polyconvexity certificate is not visible here -- which is exactly why Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex} audit them directly (cyclic work, rank-one curvature) rather than relying on this figure}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Stage--10 relative $L^2$ error, all six reported quantities of Table~\ref {tab:master}, for all six model variants: the tier-1 regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes. The uncertified ANNs (tiers 1--2) are competitive with, and on several components better than, the certified models on every accuracy metric shown here -- consistent with Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex}'s point that accuracy alone cannot distinguish a certified model from an uncertified one; only the cyclic-work and rank-one curvature audits can.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig:full-comparison-bars}{{4}{17}{Stage--10 relative $L^2$ error, all six reported quantities of Table~\ref {tab:master}, for all six model variants: the tier-1 regression ANN, the tier-2 free hyperelastic ANN, the two certified polyconvex cores, and both HPROM--ANN operating modes. The uncertified ANNs (tiers 1--2) are competitive with, and on several components better than, the certified models on every accuracy metric shown here -- consistent with Sections~\ref {sec:c1-regression} and~\ref {sec:non-polyconvex}'s point that accuracy alone cannot distinguish a certified model from an uncertified one; only the cyclic-work and rank-one curvature audits can}{figure.4}{}}
